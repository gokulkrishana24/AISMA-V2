# AISMA v2 — Enterprise Environment Configuration Template
# Copy to .env and fill strong production secrets before deployment.

# --- Database Configuration ---
# Development SQLite (default if omitted): sqlite:///./state/aisma.db
# Production PostgreSQL:
DATABASE_URL=postgresql+psycopg2://aisma:aisma_change_me_in_prod@localhost:5432/aisma_v2
POSTGRES_USER=aisma
POSTGRES_PASSWORD=aisma_change_me_in_prod
POSTGRES_DB=aisma_v2

# --- Security & Cryptography ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_strong_random_64_char_secret
INTEGRATION_VAULT_SECRET=replace_with_vault_secret_key
INTEGRATION_WEBHOOK_SECRET=replace_with_webhook_hmac_secret

# --- CORS & Frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Local AI Runtime (Ollama) ---
OLLAMA_HOST=http://localhost:11434
AISMA_TEST_MODE=false
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1

# --- External Platform OAuth Credentials (Optional: defaults to Sandbox mode when empty) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
X_API_BEARER_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=

